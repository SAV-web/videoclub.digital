---
import { fetchAllMovies } from '../lib/fetchAllMovies';
import { getPosterUrl, parseList } from '../lib/format';
import type { MovieRow } from '../lib/types';

export async function getStaticPaths() {
  const movies = await fetchAllMovies();
  return movies.map((movie) => ({
    params: { slugId: movie.slug },
    props: { movie },
  }));
}

interface Props { movie: MovieRow }
const { movie } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posterUrl = getPosterUrl(movie);
const genres = parseList(movie.genres_list);
const directors = parseList(movie.directors_list);
const actors = parseList(movie.actors_list);
const studios = parseList(movie.studios_list);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isSeries = Boolean(movie.type && String(movie.type).toLowerCase().startsWith('s'));

const pageTitle = `${movie.title}${movie.year ? ` (${movie.year})` : ''} — Videoclub Digital`;
const description = movie.synopsis
  ? movie.synopsis.slice(0, 155) + (movie.synopsis.length > 155 ? '…' : '')
  : `Ficha de ${movie.title} en Videoclub Digital.`;

// Constantes de estudio
const STUDIO_DATA: Record<string, { id: string; class: string; title: string; w: number; h: number }> = {
  N: { id: 'icon-netflix', class: 'netflix-icon', title: 'Netflix', w: 20, h: 20 },
  D: { id: 'icon-disney', class: 'disney-icon', title: 'Disney', w: 20, h: 20 },
  W: { id: 'icon-wb', class: 'wb-icon', title: 'Warner Bros.', w: 20, h: 20 },
  U: { id: 'icon-universal', class: 'universal-icon', title: 'Universal', w: 20, h: 20 },
  S: { id: 'icon-sony', class: 'sony-icon', title: 'Sony-Columbia', w: 20, h: 20 },
  P: { id: 'icon-paramount', class: 'paramount-icon', title: 'Paramount', w: 20, h: 20 },
  L: { id: 'icon-lionsgate', class: 'lionsgate-icon', title: 'Lionsgate', w: 20, h: 20 },
  Z: { id: 'icon-amazon', class: 'amazon-icon', title: 'Amazon MGM', w: 20, h: 20 },
  F: { id: 'icon-twenty', class: 'twenty-icon', title: '20th Century Fox', w: 20, h: 20 },
  T: { id: 'icon-a24', class: 'a24-icon', title: 'A24', w: 20, h: 20 },
  O: { id: 'icon-movistar', class: 'movistar-icon', title: 'Movistar', w: 20, h: 20 },
  X: { id: 'icon-miramax', class: 'miramax-icon', title: 'Miramax', w: 20, h: 20 },
  A: { id: 'icon-apple', class: 'apple-icon', title: 'Apple TV', w: 20, h: 20 },
  C: { id: 'icon-canalplus', class: 'canalplus-icon', title: 'StudioCanal', w: 20, h: 20 },
  B: { id: 'icon-bbc', class: 'bbc-icon', title: 'BBC', w: 20, h: 20 }
};

// Formatos de visualización
const countryName = movie.countries?.name || '';

function formatRuntime(minutes: number | null | undefined, isSeries: boolean): string {
  if (!minutes) return isSeries ? 'Serie TV' : 'Película';
  const hrs = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (isSeries) return `${minutes} min/ep`;
  if (hrs === 0) return `${mins} m`;
  if (mins === 0) return `${hrs} h`;
  return `${hrs} h ${mins} m`;
}
---

<!DOCTYPE html>
<html lang="es" class="theme-dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl.toString()} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={isSeries ? 'video.tv_show' : 'video.movie'} />
  <meta property="og:url" content={canonicalUrl.toString()} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {posterUrl && <meta property="og:image" content={posterUrl} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {posterUrl && <meta name="twitter:image" content={posterUrl} />}

  <!-- Schema.org JSON-LD (Rich Snippets) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': isSeries ? 'TVSeries' : 'Movie',
    'name': movie.title,
    'alternateName': movie.original_title || undefined,
    'datePublished': movie.year ? String(movie.year) : undefined,
    'image': posterUrl || undefined,
    'description': movie.synopsis || undefined,
    'duration': movie.minutes ? `PT${movie.minutes}M` : undefined,
    'aggregateRating': (movie.avg_rating || movie.fa_rating || movie.imdb_rating) ? {
      '@type': 'AggregateRating',
      'ratingValue': movie.avg_rating || movie.fa_rating || movie.imdb_rating,
      'bestRating': '10',
      'worstRating': '1',
      'ratingCount': (movie.fa_votes || 0) + (movie.imdb_votes || 0) || 1
    } : undefined,
    'genre': genres.length > 0 ? genres : undefined,
    'director': directors.map(d => ({ '@type': 'Person', 'name': d })),
    'actor': actors.map(a => ({ '@type': 'Person', 'name': a })),
    'countryOfOrigin': countryName ? { '@type': 'Country', 'name': countryName } : undefined
  })} />

  <!-- Inline CSS crítico del tema de videoclub.digital -->
  <style is:global>
    :root {
      --color-bg-primary: #0f172a;
      --color-bg-surface: #1e293b;
      --color-bg-elevated: #334155;
      --color-text-primary: #f8fafc;
      --color-text-secondary: #94a3b8;
      --color-text-muted: #64748b;
      --color-accent: #38bdf8;
      --color-accent-darker: #0284c7;
      --color-rating-star: #ffbd07;
      --font-family: 'Inter', system-ui, -apple-system, sans-serif;
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-sm: 8px;
    }

    /* Modo Claro */
    html.theme-light {
      --color-bg-primary: #f8fafc;
      --color-bg-surface: #ffffff;
      --color-bg-elevated: #f1f5f9;
      --color-text-primary: #0f172a;
      --color-text-secondary: #475569;
      --color-text-muted: #94a3b8;
      --color-accent: #0284c7;
      --color-accent-darker: #0369a1;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background-color: var(--color-bg-primary);
      color: var(--color-text-primary);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Layout Header */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 12px 24px;
    }
    html.theme-light .site-header {
      background: rgba(248, 250, 252, 0.85);
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .logo-accent {
      color: var(--color-accent);
    }
    .btn-header-cta {
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-darker));
      color: #fff;
      font-weight: 600;
      padding: 8px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 14px rgba(56, 189, 248, 0.3);
    }
    .btn-header-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
    }

    /* Main Container & Hero Layout */
    .main-content {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 40px 24px;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin-bottom: 24px;
    }
    .breadcrumb a:hover {
      color: var(--color-accent);
    }

    .movie-hero-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 40px;
      align-items: start;
    }

    @media (max-width: 860px) {
      .movie-hero-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .poster-column {
        max-width: 280px;
        margin: 0 auto;
      }
    }

    /* Columna Poster */
    .poster-card {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      background-color: var(--color-bg-surface);
      aspect-ratio: 2/3;
    }
    .poster-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .poster-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: var(--color-text-muted);
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }

    /* Columna Detalles */
    .movie-details {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .title-header h1 {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 6px;
    }
    .original-title {
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      font-style: italic;
      font-weight: 400;
    }

    .meta-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }
    .badge {
      background: var(--color-bg-surface);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 4px 12px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-text-secondary);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    html.theme-light .badge {
      border-color: rgba(0, 0, 0, 0.1);
    }
    .badge-accent {
      background: rgba(56, 189, 248, 0.1);
      color: var(--color-accent);
      border-color: rgba(56, 189, 248, 0.3);
    }

    /* Bloque Ratings */
    .ratings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 16px;
    }
    .rating-card {
      background: var(--color-bg-surface);
      border-radius: var(--radius-md);
      padding: 16px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    html.theme-light .rating-card {
      border-color: rgba(0, 0, 0, 0.05);
    }
    .rating-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      font-weight: 700;
    }
    .rating-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--color-rating-star);
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .rating-sub {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
    }

    /* Sinopsis */
    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--color-text-primary);
    }
    .synopsis-text {
      font-size: 1rem;
      color: var(--color-text-secondary);
      line-height: 1.65;
    }

    /* Cast / Ficha Técnica */
    .meta-list-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 640px) {
      .meta-list-grid {
        grid-template-columns: 1fr;
      }
    }
    .meta-block {
      background: var(--color-bg-surface);
      padding: 16px;
      border-radius: var(--radius-md);
    }
    .meta-block-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      margin-bottom: 6px;
      font-weight: 700;
    }
    .meta-block-values {
      font-size: 0.95rem;
      color: var(--color-text-primary);
      font-weight: 500;
    }

    .platform-icons-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 32px 24px;
      margin-top: 60px;
      text-align: center;
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }
    html.theme-light .site-footer {
      border-top-color: rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>

  <!-- Sprite SVG reutilizable -->
  <svg style="display: none;" aria-hidden="true">
    <symbol id="icon-netflix" viewBox="0 0 24 24"><path fill="#E50914" d="M15.3 22h3.6V2L13.5 13.5V22h1.8zM5.1 22h3.6V2H5.1v20zM13.5 2L8.7 13.5V2H5.1v20h3.6l4.8-11.5V22h3.6V2h-3.6z"/></symbol>
    <symbol id="icon-disney" viewBox="0 0 24 24"><path fill="#113CCF" d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2z"/></symbol>
    <symbol id="icon-wb" viewBox="0 0 24 24"><path fill="#0052B4" d="M12 2L2 6v12l10 4 10-4V6L12 2z"/></symbol>
    <symbol id="icon-universal" viewBox="0 0 24 24"><path fill="#000" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/></symbol>
    <symbol id="icon-sony" viewBox="0 0 24 24"><path fill="#000" d="M2 6h20v12H2z"/></symbol>
    <symbol id="icon-paramount" viewBox="0 0 24 24"><path fill="#0066CC" d="M12 2l10 18H2z"/></symbol>
    <symbol id="icon-amazon" viewBox="0 0 24 24"><path fill="#FF9900" d="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2z"/></symbol>
  </svg>

  <header class="site-header">
    <div class="header-container">
      <a href={baseUrl} class="brand-logo">
        <span class="logo-icon">🎬</span>
        <span class="logo-text">videoclub<span class="logo-accent">.digital</span></span>
      </a>
      <div class="header-controls" style="display: flex; align-items: center; gap: 12px;">
        <button id="theme-toggle" type="button" class="sidebar-control-button theme-toggle" title="Modo oscuro" aria-label="Modo oscuro" aria-pressed="false" style="background: none; border: none; cursor: pointer; padding: 6px; display: flex; align-items: center; justify-content: center; color: var(--color-text-primary); border-radius: 9999px;">
          <svg class="theme-icon moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="theme-icon sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>
        <a href={`${baseUrl}?movie=${movie.id}`} class="btn-header-cta">
          <span class="btn-icon">⚡</span> Abrir en la App
        </a>
      </div>
    </div>
  </header>

  <main class="main-content">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={baseUrl}>Inicio</a>
      <span>/</span>
      <span>{isSeries ? 'Series' : 'Películas'}</span>
      <span>/</span>
      <span style="color: var(--color-text-primary); font-weight: 600;">{movie.title}</span>
    </nav>

    <div class="movie-hero-grid">
      <!-- Columna Poster -->
      <div class="poster-column">
        <div class="poster-card">
          {posterUrl ? (
            <img src={posterUrl} alt={`Póster de ${movie.title}`} class="poster-img" loading="eager" decoding="async" />
          ) : (
            <div class="poster-placeholder">
              <span style="font-size: 3rem;">🎬</span>
              <span>Sin imagen</span>
            </div>
          )}
        </div>
      </div>

      <!-- Columna Detalles -->
      <div class="movie-details">
        <div class="title-header">
          <h1>{movie.title}</h1>
          {movie.original_title && movie.original_title !== movie.title && (
            <div class="original-title">{movie.original_title}</div>
          )}
        </div>

        <div class="meta-badges">
          {movie.year && <span class="badge badge-accent">📅 {movie.year}{movie.year_end ? `–${movie.year_end}` : ''}</span>}
          <span class="badge">⏱️ {formatRuntime(movie.minutes, isSeries)}</span>
          {countryName && (
            <span class="badge">
              🌍 {countryName}
            </span>
          )}
          <span class="badge">{isSeries ? '📺 Serie TV' : '🎬 Película'}</span>
        </div>

        <!-- Calificaciones -->
        <div class="ratings-grid">
          {movie.avg_rating && (
            <div class="rating-card">
              <span class="rating-label">Nota Media</span>
              <span class="rating-value">★ {movie.avg_rating.toFixed(1)}</span>
              <span class="rating-sub">Videoclub.digital</span>
            </div>
          )}
          {movie.fa_rating && (
            <div class="rating-card">
              <span class="rating-label">FilmAffinity</span>
              <span class="rating-value" style="color: var(--color-accent);">FA {movie.fa_rating.toFixed(1)}</span>
              {movie.fa_votes && <span class="rating-sub">{movie.fa_votes.toLocaleString('es-ES')} votos</span>}
            </div>
          )}
          {movie.imdb_rating && (
            <div class="rating-card">
              <span class="rating-label">IMDb</span>
              <span class="rating-value" style="color: #f5c518;">★ {movie.imdb_rating.toFixed(1)}</span>
              {movie.imdb_votes && <span class="rating-sub">{movie.imdb_votes.toLocaleString('es-ES')} votos</span>}
            </div>
          )}
        </div>

        <!-- Sinopsis -->
        <div>
          <h2 class="section-title">Sinopsis</h2>
          <p class="synopsis-text">{movie.synopsis || 'Sinópsis no disponible para esta ficha.'}</p>
        </div>

        <!-- Ficha Técnica -->
        <div class="meta-list-grid">
          {directors.length > 0 && (
            <div class="meta-block">
              <div class="meta-block-title">Dirección</div>
              <div class="meta-block-values">{directors.join(', ')}</div>
            </div>
          )}
          {genres.length > 0 && (
            <div class="meta-block">
              <div class="meta-block-title">Género</div>
              <div class="meta-block-values">{genres.join(', ')}</div>
            </div>
          )}
          {actors.length > 0 && (
            <div class="meta-block" style="grid-column: 1 / -1;">
              <div class="meta-block-title">Reparto Principal</div>
              <div class="meta-block-values">{actors.join(', ')}</div>
            </div>
          )}
          {studios.length > 0 && (
            <div class="meta-block" style="grid-column: 1 / -1;">
              <div class="meta-block-title">Estudios / Productoras</div>
              <div class="platform-icons-row">
                {studios.map(code => {
                  const s = STUDIO_DATA[code];
                  return s ? <span class={`badge ${s.class}`}>{s.title}</span> : <span class="badge">{code}</span>;
                })}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} Videoclub Digital — PWA de Descubrimiento Cinematográfico.</p>
  </footer>

  <script is:inline>
    // Tema claro / oscuro sincronizado con la App principal
    (function() {
      const savedTheme = localStorage.getItem('videoclub:theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('theme-dark');
        document.documentElement.classList.add('theme-light');
      }

      const toggleBtn = document.getElementById('theme-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isLight = document.documentElement.classList.contains('theme-light');
          if (isLight) {
            document.documentElement.classList.remove('theme-light');
            document.documentElement.classList.add('theme-dark');
            localStorage.setItem('videoclub:theme', 'dark');
          } else {
            document.documentElement.classList.remove('theme-dark');
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('videoclub:theme', 'light');
          }
        });
      }
    })();
  </script>
</body>
</html>
