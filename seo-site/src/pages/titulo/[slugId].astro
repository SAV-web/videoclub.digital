---
import { fetchAllMovies } from '../../lib/fetchAllMovies';
import { getPosterUrl, parseList } from '../../lib/format';
import type { SeoMovieDocument } from '../../lib/types';
import { STUDIO_DATA } from '../../../../src/shared/constants';
import { isSeriesType, formatRuntime, formatYear, calculateAverageStars, getTitleLengthClass, formatVotesUnified, preserveHyphenatedWords } from '../../../../src/shared/formatters';
import { toSlug, genreToSlug } from '../../../../src/shared/slugs';
import '../../../../src/css/variables.css';



export async function getStaticPaths() {
  const movies = await fetchAllMovies();
  return movies.map((movie) => ({
    params: { slugId: movie.slug },
    props: { movie },
  }));
}

interface Props { movie: SeoMovieDocument }

const { movie } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posterUrl = getPosterUrl(movie);
const absolutePosterUrl = posterUrl ? (posterUrl.startsWith('http') ? posterUrl : `https://videoclub.digital${posterUrl}`) : '';
const genres = parseList(movie.genres_list);
const directors = parseList(movie.directors_list);
const actors = parseList(movie.actors_list);
const studios = parseList(movie.studios_list);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isSeries = isSeriesType(movie.type);


const pageTitle = `${movie.title}${movie.year ? ` (${movie.year})` : ''} — Videoclub Digital`;
const description = movie.synopsis
  ? movie.synopsis.slice(0, 155) + (movie.synopsis.length > 155 ? '…' : '')
  : `Ficha de ${movie.title} en Videoclub Digital.`;


// Formatos de visualización
const countryCode = movie.countries?.code || null;
const countryName = movie.countries?.name || '';

const durationText = formatRuntime(movie.minutes, isSeries);
const episodesText = movie.episodes ? `${movie.episodes} ep` : null;

// Clases de tamaño de título
const titleLengthClass = getTitleLengthClass(movie.title);

const displayOriginalTitle = movie.original_title?.trim() || movie.title;
const origTitleLengthClass = getTitleLengthClass(displayOriginalTitle);

// Estrellas continuas (0-3) y gestión de suspenso (1 estrella hueca)
const isSuspenso = typeof movie.avg_rating === 'number' && movie.avg_rating > 0 && movie.avg_rating <= 5.5;
const avgStars = calculateAverageStars(movie.avg_rating);
const clip1 = isSuspenso ? 100 : (1 - Math.max(0, Math.min(1, avgStars - 0))) * 100;
const clip2 = isSuspenso ? 100 : (1 - Math.max(0, Math.min(1, avgStars - 1))) * 100;
const clip3 = isSuspenso ? 100 : (1 - Math.max(0, Math.min(1, avgStars - 2))) * 100;



// Cálculo de barras de votos y votos unificados
const SQRT_MAX_VOTES = { FA: Math.sqrt(220000), IMDB: Math.sqrt(3200000) };


const faBarWidth = movie.fa_votes ? Math.min(100, (Math.sqrt(movie.fa_votes) / SQRT_MAX_VOTES.FA) * 100) : 0;
const imdbBarWidth = movie.imdb_votes ? Math.min(100, (Math.sqrt(movie.imdb_votes) / SQRT_MAX_VOTES.IMDB) * 100) : 0;
const formattedFaVotes = formatVotesUnified(movie.fa_votes);
const formattedImdbVotes = formatVotesUnified(movie.imdb_votes);


const sameAs = [movie.imdb_id, movie.fa_id, movie.wikipedia, movie.justwatch].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isSeries ? 'TVSeries' : 'Movie',
  name: movie.title,
  ...(sameAs.length ? { sameAs } : {}),
  ...(movie.original_title ? { alternateName: movie.original_title } : {}),
  ...(movie.year ? { datePublished: String(movie.year) } : {}),
  ...(movie.synopsis ? { description: movie.synopsis } : {}),
  ...(absolutePosterUrl ? { image: absolutePosterUrl } : {}),
  ...(directors.length ? { director: directors.map((name) => ({ '@type': 'Person', name })) } : {}),
  ...(actors.length ? { actor: actors.map((name) => ({ '@type': 'Person', name })) } : {}),
  ...(movie.avg_rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: movie.avg_rating.toFixed(1),
          bestRating: '10',
          ratingCount: (movie.fa_votes || 0) + (movie.imdb_votes || 0),
        },
      }
    : {}),
};
const primaryGenre = genres.length > 0 ? genres[0] : null;
const primaryGenreSlug = primaryGenre ? genreToSlug(primaryGenre) : null;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://videoclub.digital';
const mediaTypePath = isSeries ? 'series' : 'peliculas';
const mediaTypeName = isSeries ? 'Series' : 'Películas';

const breadcrumbElements = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Inicio',
    item: `${siteOrigin}/`,
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: mediaTypeName,
    item: `${siteOrigin}/${mediaTypePath}/`,
  },
];

if (primaryGenre && primaryGenreSlug) {
  breadcrumbElements.push({
    '@type': 'ListItem',
    position: 3,
    name: primaryGenre,
    item: `${siteOrigin}/genero/${primaryGenreSlug}/${mediaTypePath}/`,
  });
}

breadcrumbElements.push({
  '@type': 'ListItem',
  position: breadcrumbElements.length + 1,
  name: movie.title,
  item: canonicalUrl.href,
});

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbElements,
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
  <!-- Anti-flicker para sincronización de modo claro/oscuro con el grid -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem("theme");
        var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = stored === "dark" || (!stored && systemDark);
        if (isDark) {
          document.documentElement.classList.add("dark-mode");
          document.documentElement.classList.remove("light-mode");
        } else if (stored === "light" || (!stored && !systemDark)) {
          document.documentElement.classList.add("light-mode");
          document.documentElement.classList.remove("dark-mode");
        }
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        metas.forEach(function(m) { m.setAttribute("content", isDark ? "#0d0d0d" : "#f5f5f5"); });
      } catch (e) {}
    })();
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OpenGraph / Facebook / WhatsApp -->
  <meta property="og:type" content="video.movie" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {absolutePosterUrl && <meta property="og:image" content={absolutePosterUrl} />}
  <meta property="og:url" content={canonicalUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {absolutePosterUrl && <meta name="twitter:image" content={absolutePosterUrl} />}

  <!-- Tipografía Inter Variable Autoalojada (Misma que la SPA) -->
  <link rel="preconnect" href="https://wibygecgfczcvaqewleq.supabase.co" crossorigin />
  <link rel="preload" href="https://wibygecgfczcvaqewleq.supabase.co/storage/v1/object/public/assets/Inter-Variable-v41.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <!-- Speculation Rules API: Prerender nativo instantáneo entre fichas de película (Chromium) -->
  <script type="speculationrules" is:inline>
    {
      "prerender": [
        {
          "where": {
            "and": [
              { "href_matches": "/titulo/*" },
              { "not": { "href_matches": "/titulo/*#*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
  </script>

  <!-- Estilos visuales identicos al Modal de la SPA -->
  <style is:global>
    /* Inter Variable: Un solo archivo para todos los pesos */
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("https://wibygecgfczcvaqewleq.supabase.co/storage/v1/object/public/assets/Inter-Variable-v41.woff2") format("woff2");
    }

    /* Fallback métricamente ajustado para reducir CLS */
    @font-face {
      font-family: "Inter Fallback";
      src: local("Arial");
      ascent-override: 92.77%;
      descent-override: 24.41%;
      line-gap-override: 0%;
      size-adjust: 107.8%;
    }

    /* EXTENSIONES DE LAYOUT Y OVERLAY PARA SEO SITE */
    :root, html.dark-mode {
      --color-header-bg: rgba(13, 13, 13, 0.85);
      --color-overlay-bg: rgba(0, 0, 0, 0.65);
      --modal-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    html.light-mode {
      --color-header-bg: rgba(255, 255, 255, 0.85);
      --color-overlay-bg: rgba(0, 0, 0, 0.18);
      --modal-shadow: 0 12px 40px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.08);
    }

    @media (prefers-color-scheme: light) {
      :root:not(.dark-mode) {
        --color-header-bg: rgba(255, 255, 255, 0.85);
        --color-overlay-bg: rgba(0, 0, 0, 0.18);
        --modal-shadow: 0 12px 40px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.08);
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background-color: var(--color-bg) !important;
      color: var(--color-text-primary) !important;
      font-family: var(--font-body);
      min-height: 100vh;
      width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    /* ACCESIBILIDAD: Anillos de foco para navegación por teclado */
    .brand-logo:focus-visible,
    .btn-header-cta:focus-visible,
    .card-action-btn:focus-visible,
    .year-link:focus-visible,
    .rating-left:focus-visible,
    [data-template="justwatch-link"]:focus-visible,
    [data-template="wikipedia-link"]:focus-visible,
    .front-director-info a:focus-visible,
    [data-template="actors"] a:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px var(--color-focus);
    }

    .brand-logo:focus-visible,
    .btn-header-cta:focus-visible,
    .card-action-btn:focus-visible {
      border-radius: 9999px;
    }


    .year-link:focus-visible,
    .rating-left:focus-visible,
    [data-template="justwatch-link"]:focus-visible,
    [data-template="wikipedia-link"]:focus-visible {
      border-radius: var(--radius-sm);
    }

    .front-director-info a:focus-visible,
    [data-template="actors"] a:focus-visible {
      border-radius: var(--radius-xs);
    }

    /* HEADER DE MARCA SUPERIOR */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      z-index: 2000;
      background: var(--color-header-bg);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
      padding: 0 20px;
      display: flex;
      align-items: center;
    }

    .header-content {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      font-family: var(--font-title);
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--color-text-primary);
      transition: opacity 0.2s ease;

      &:hover {
        opacity: 0.85;
      }
    }

    .logo-line-1,
    .logo-line-2 {
      display: block;
    }

    .header-controls {
      display: flex;
      align-items: center;
    }

    .btn-header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.35);
      border-radius: 9999px;
      text-decoration: none;
      transition: all 0.2s ease;

      &:hover {
        background: #f59e0b;
        color: #0d0d0d;
        transform: scale(1.08);
      }

      & svg {
        width: 20px;
        height: 20px;
      }
    }

    /* CORTINA OSCURA Y VENTANA MODAL (SPA QUICK VIEW) */
    .quick-view-overlay {
      position: fixed;
      inset: 0;
      z-index: var(--z-index-overlay);
      background-color: var(--color-overlay-bg);
      backdrop-filter: blur(6px) saturate(85%);
      -webkit-backdrop-filter: blur(6px) saturate(85%);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .quick-view-modal {
      position: fixed;
      z-index: calc(var(--z-index-overlay) + 1);
      display: flex;
      background-color: var(--color-surface-2);
      box-shadow: var(--modal-shadow);
      overflow: hidden;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .quick-view-content {
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: var(--color-border) var(--color-bg);
    }

    .quick-view-content::-webkit-scrollbar,
    .flip-card-back::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .quick-view-content::-webkit-scrollbar-track,
    .flip-card-back::-webkit-scrollbar-track {
      background: var(--color-bg);
    }
    .quick-view-content::-webkit-scrollbar-thumb,
    .flip-card-back::-webkit-scrollbar-thumb {
      background-color: var(--color-border);
      border-radius: 9999px;
      border: 2px solid var(--color-bg);
    }
    .quick-view-content::-webkit-scrollbar-thumb:hover,
    .flip-card-back::-webkit-scrollbar-thumb:hover {
      background-color: var(--color-text-secondary);
    }

    .is-quick-view.movie-card {
      aspect-ratio: auto;
      perspective: none;
      animation: none;
      width: 100%;
      height: 100%;
    }

    .is-quick-view .flip-card-inner {
      transform-style: flat;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      height: 100%;
      background-color: var(--color-surface-1);
      border: none;
    }

    .is-quick-view :is(.flip-card-front, .flip-card-back) {
      position: relative;
      inset: auto;
      transform: none;
      backface-visibility: visible;
      height: auto;
      overflow: visible;
      background-color: var(--color-surface-1);
      color: var(--color-text-primary);
    }


    .is-quick-view .flip-card-front {
      padding: var(--space-lg);
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
    }

    .is-quick-view .flip-card-back {
      padding: var(--space-lg);
      flex-grow: 1;
      min-width: 0;
      pointer-events: auto;
    }

    .is-quick-view .poster-container {
      height: auto;
      width: 100%;
      border: none;
      position: relative;
    }

    .is-quick-view .poster-container img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-xxl);
      box-shadow: var(--shadow);
      border: none;
      display: block;
      object-fit: cover;
      pointer-events: none !important;
      user-select: none !important;
      -webkit-user-select: none !important;
      -webkit-user-drag: none !important;
      -webkit-touch-callout: none !important;
    }

    .is-quick-view .movie-summary {
      padding-inline: 0;
      padding-top: 0;
      display: flex;
      flex-direction: column;
    }

    .is-quick-view .title-director-block {
      min-height: 82px;
      justify-content: center;
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
    }

    .is-quick-view .movie-summary h1[data-template="title"],
    .is-quick-view .movie-summary .movie-main-title {
      font-size: 2rem;
      font-weight: var(--font-weight-extrabold);
      color: var(--color-text-primary);
      line-height: 1.1;
      margin-bottom: 4px;
      letter-spacing: -0.03em;


      &.title-medium { font-size: 1.7rem; }
      &.title-long { font-size: 1.4rem; }
      &.title-xl-long { font-size: 1.15rem; }
      &.title-xxl-long { font-size: 1rem; }
      &.title-xxxl-long { font-size: 0.85rem; }
    }


    .is-quick-view .front-director-info {
      font-size: calc(var(--font-size-xs) * 1.5);
      color: var(--color-text-secondary);
      margin-top: 4px;
      margin-bottom: var(--space-md);
      line-height: 1.4;
      white-space: normal;
      display: block;
      width: 100%;

      & a {
        color: inherit;
        text-decoration: none;

        &:hover {
          color: var(--color-text-primary);
          text-decoration: underline;
        }
      }
    }

    .is-quick-view .card-rating-block {
      position: relative;
      z-index: 10;
      transform: none;
      padding: 0 0 2px;
      margin: -8px 0 0;
      pointer-events: auto;
      justify-content: center;
      align-items: center;
      gap: var(--space-lg);
      display: flex;
    }

    .is-quick-view .card-rating-block * {
      pointer-events: auto;
    }

    .is-quick-view .star-rating-container {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      cursor: pointer;
    }

    .star-rating-container.is-interactive .star-icon:hover {
      transform: scale(1.35);
      z-index: 20;
      filter: drop-shadow(0 0 4px rgba(255, 189, 7, 0.6));
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .star-rating-container.is-interactive .star-icon:active {
      transform: scale(0.92);
      filter: brightness(0.95);
    }

    .is-quick-view .star-icon {
      width: 42px;
      height: 42px;
      position: relative;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .star-icon-path {
      stroke: var(--color-accent);
      stroke-width: 2;
      stroke-linejoin: round;
      stroke-linecap: round;
    }

    .star-icon-path--empty { fill: transparent; }
    .star-icon-path--filled {
      fill: var(--color-accent);
      clip-path: inset(0 100% 0 0);
    }

    .is-quick-view .card-action-btn {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-primary);
      text-decoration: none;
      transition: background-color 0.2s ease, transform 0.2s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: scale(1.05);
      }

      &.is-active {
        background: rgba(229, 9, 20, 0.2);
        border-color: #e50914;

        & svg {
          color: #e50914 !important;
          fill: #e50914 !important;
          stroke: #e50914 !important;
        }
      }

      & svg {
        width: 38px;
        height: 38px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5px;
      }
    }

    .is-quick-view .movie-meta {
      display: flex;
      align-items: center;
      margin-top: auto;
      padding-top: var(--space-xs);
    }

    .is-quick-view .modal-horizontal-divider {
      flex-grow: 1;
      height: 1px;
      background-color: var(--color-border);
      align-self: center;
      margin-inline: var(--space-md);
      opacity: 0.8;
    }

    .is-quick-view .card-icons-line {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }

    .is-quick-view .platform-icon svg {
      width: 33px;
      height: 33px;
    }

    /* COLORES ESTUDIOS (Light Mode por defecto o .light-mode) */
    .netflix-icon { color: #e50914; }
    .disney-icon { color: #990000; }
    .wb-icon { color: #000b6c; }
    .universal-icon { color: #444444; }
    .sony-icon { color: #004098; }
    .paramount-icon { color: #0063ff; }
    .lionsgate-icon { color: #CC7722; }
    .amazon-icon { color: #f6a61f; }
    .twenty-icon { color: #000b6c; }
    .a24-icon { color: #000; }
    .movistar-icon { color: #00a9e0; }
    .miramax-icon { color: #005596; }
    .apple-icon { color: #000; }
    .canalplus-icon { color: #000; }
    .bbc-icon { color: #000; }

    /* COLORES ESTUDIOS (Dark Mode) */
    :root:not(.light-mode) .disney-icon, html.dark-mode .disney-icon { color: #D9534F; }
    :root:not(.light-mode) .wb-icon, html.dark-mode .wb-icon { color: #4da4f2; }
    :root:not(.light-mode) .universal-icon, html.dark-mode .universal-icon { color: #BBBBBB; }
    :root:not(.light-mode) .sony-icon, html.dark-mode .sony-icon { color: #3182ce; }
    :root:not(.light-mode) .paramount-icon, html.dark-mode .paramount-icon { color: #E0E0E0; }
    :root:not(.light-mode) .lionsgate-icon, html.dark-mode .lionsgate-icon { color: #f9d7b5; }
    :root:not(.light-mode) .twenty-icon, html.dark-mode .twenty-icon { color: #E0E0E0; }
    :root:not(.light-mode) .a24-icon, html.dark-mode .a24-icon { color: #fff; }
    :root:not(.light-mode) .miramax-icon, html.dark-mode .miramax-icon { color: #4da4f2; }
    :root:not(.light-mode) .apple-icon, html.dark-mode .apple-icon { color: #fff; }
    :root:not(.light-mode) .canalplus-icon, html.dark-mode .canalplus-icon { color: #fff; }
    :root:not(.light-mode) .bbc-icon, html.dark-mode .bbc-icon { color: #fff; }

    .is-quick-view .year-flag-group {
      display: flex;
      align-items: center;
      font-size: 2rem;
      line-height: 1;
      gap: var(--space-sm);
    }

    .is-quick-view .year-link {
      color: inherit;
      text-decoration: none;
      font-weight: var(--font-weight-bold);
    }

    .country-info { display: flex; align-items: center; gap: var(--space-xxs); }
    .is-quick-view .country-flag-icon svg {
      width: 28px;
      height: 28px;
      box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
    }

    /* COSTADO TRASERO (DERECHO EN DESKTOP) */
    .is-quick-view .back-meta-header {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      width: 100%;
      margin-bottom: var(--space-lg);
    }

    .is-quick-view .episode-duration-group {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: calc(var(--font-size-sm) * 1.5);
      font-weight: var(--font-weight-bold, 700);
      letter-spacing: 1px;
      color: var(--color-text-secondary);
    }


    [data-template="wikipedia-link"],
    [data-template="justwatch-link"] {
      display: flex;
      align-items: center;
      text-decoration: none;
      margin-left: var(--space-xs);

      & svg {
        width: 1.5em;
        height: 1.5em;
      }
    }

    .is-quick-view .ratings-container {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .is-quick-view .rating-line {
      display: flex;
      align-items: center;
      gap: 12px;
      font-variant-numeric: tabular-nums;
    }

    .is-quick-view .rating-left {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--color-text-primary);
      font-size: calc(var(--font-size-base) * 1.5);
      font-weight: var(--font-weight-bold);
      text-decoration: none;
      flex-shrink: 0;

      &:hover { opacity: 0.85; }
    }

    .is-quick-view .rating-icon {
      width: 1.6em;
      height: 1.6em;
      border-radius: var(--radius-sm);
    }

    .is-quick-view .rating-votes-count {
      display: flex !important;
      flex-direction: column;
      justify-content: center;
      min-width: 6ch;
      white-space: nowrap;
      text-align: right;
      font-size: var(--font-size-base);
      font-weight: bold;
      line-height: 1;

      &::after {
        content: "votos";
        font-size: 0.6em;
        font-weight: normal;
        color: var(--color-text-secondary);
        text-align: right;
        width: 100%;
        margin-top: 2px;
        white-space: nowrap;
      }
    }


    .is-quick-view .rating-bar-container {
      flex-grow: 1;
      width: 100%;
      height: var(--space-sm);
      border-radius: var(--space-xxs);
      background-color: var(--color-bg);
      overflow: hidden;
      position: relative;
    }

    .is-quick-view .rating-bar {
      height: 100%;
      border-radius: var(--space-xxs);
      background-color: var(--color-accent);
    }

    .is-quick-view .back-original-title-wrapper {
      margin-top: var(--space-lg);
      margin-bottom: 0;
      padding: 0;

      & span {
        font-size: 1.6rem;
        font-weight: bold;
        line-height: 1.1;
        color: var(--color-text-primary);

        &.title-medium { font-size: 1.45rem; }
        &.title-long { font-size: 1.3rem; }
        &.title-xl-long { font-size: 1.05rem; }
      }
    }

    .is-quick-view .front-director-info {
      font-size: calc(var(--font-size-xs) * 1.5);
      font-weight: var(--font-weight-normal);
      color: var(--color-text-secondary);
      margin-top: 4px;
      margin-bottom: var(--space-xs);
      line-height: 1.4;

      & a {
        color: inherit;
        text-decoration: none;
        transition: color var(--duration-fast);

        &:hover {
          color: var(--color-text-primary);
          text-decoration: underline;
        }
      }
    }

    .is-quick-view .details-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      margin-bottom: 0;
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
      font-size: calc(var(--font-size-xs) * 1.5);
      line-height: 1.5;
      color: var(--color-text-secondary);
    }

    .is-quick-view .detail-item[data-template="actors-container"],
    .is-quick-view .detail-item[data-template="genre-container"] {
      display: block;
      white-space: normal;
    }

    .is-quick-view :is([data-template="actors"], [data-template="genre"], .detail-data) a {
      color: var(--color-text-primary);
      text-decoration: none;
      display: inline;
      white-space: nowrap;

      &:hover {
        color: var(--color-text-primary);
        text-decoration: underline;
      }
    }



    .is-quick-view .detail-label {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: -2px;
      margin-right: 8px;
      color: var(--color-accent);
      flex-shrink: 0;
    }

    .is-quick-view .detail-icon {
      width: 18px;
      height: 18px;
      max-width: 18px;
      max-height: 18px;
      stroke: currentColor;
      stroke-width: 2.6;
      fill: none;
      flex-shrink: 0;
      display: inline-block;
    }

    .is-quick-view .detail-label-title {
      display: inline-block;
      font-weight: var(--font-weight-bold, 700);
      color: var(--color-text-primary);
      margin-right: 0.5em;
    }



    .is-quick-view .scrollable-content {
      overflow: visible;
      height: auto;

      &::after { display: none; }
    }

    .is-quick-view .plot-summary-final {
      margin-top: var(--space-lg);
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
      font-size: calc(var(--font-size-xs) * 1.5);
      line-height: 1.5;
      color: var(--color-text-secondary);
    }

    /* ADAPTACIÓN ESCRITORIO (min-width: 701px) - Ventana Flotante Clásica 2 Columnas */
    @media (min-width: 701px) {
      .quick-view-modal {
        top: 50%;
        left: 50%;
        width: 90%;
        max-width: 720px;
        max-height: 92vh;
        height: auto;
        border-radius: var(--radius-xl);
        transform: translate(-50%, -50%);
      }

      .is-quick-view .flip-card-inner {
        display: block;
        position: relative;
        overflow: visible;
      }

      .is-quick-view .flip-card-front {
        width: 50%;
        height: auto;
        border-right: 1px solid var(--color-border);
        border-bottom: none;
        overflow-y: hidden;
      }

      .is-quick-view .flip-card-back {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: auto;
        width: 50%;
        overflow-y: auto;
        scrollbar-width: thin;
      }
    }

    /* ADAPTACIÓN MÓVIL (max-width: 700px) - Bottom Sheet desde abajo */
    @media (max-width: 700px) {
      .site-header {
        padding: 0 12px;
      }

      .quick-view-modal {
        top: auto;
        bottom: 0;
        left: 50%;
        width: 96%;
        height: 92dvh;
        max-height: 92dvh;
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        transform: translate(-50%, 0);
      }

      /* Barrita superior de arrastre */
      .quick-view-modal::before {
        content: "";
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 5px;
        background-color: var(--color-border);
        border-radius: 10px;
        z-index: 10;
        pointer-events: none;
      }

      .is-quick-view .flip-card-inner {
        flex-direction: column;
      }

      .is-quick-view .flip-card-front {
        padding-top: 30px;
        padding-bottom: var(--space-xs);
        border-bottom: none;
        width: 100%;
      }

      .is-quick-view .poster-container {
        width: 70%;
        margin-inline: auto;
      }

      .is-quick-view .flip-card-back {
        padding-top: 0;
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- Header Superior de Marca -->
  <header class="site-header">
    <div class="header-content">
      <a href={baseUrl} class="brand-logo" aria-label="Videoclub Digital">
        <span class="logo-line-1">videoclub</span>
        <span class="logo-line-2">.digital</span>
      </a>
      <div class="header-controls">
        <a href={`${baseUrl}?movie=${movie.id}`} class="btn-header-cta" title="Abrir ficha en el videoclub" aria-label="Abrir ficha en el videoclub">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Cortina Oscura (Overlay) -->
  <div class="quick-view-overlay is-visible"></div>

  <!-- Contenedor Ventana Modal (Quick View) -->
  <div id="quick-view-modal" class="quick-view-modal is-visible" role="dialog" aria-modal="true">
    <div id="quick-view-content" class="quick-view-content">
      
      <!-- Ficha de Película con contrato de clases de la SPA -->
      <article class="movie-card is-quick-view" data-movie-id={movie.id}>
        <div class="flip-card-inner">

          <!-- COLUMNA IZQUIERDA EN DESKTOP / ARRIBA EN MÓVIL (FRONTCARD) -->
          <div class="flip-card-front">
            
            <!-- Contenedor del Póster -->
            <div class="poster-container">
              {posterUrl ? (
                <img 
                  src={posterUrl} 
                  alt={`Póster de ${movie.title}`} 
                  width="400" 
                  height="496" 
                  loading="eager" 
                  fetchpriority="high"
                  class="loaded"
                />
              ) : (
                <div class="poster-fallback" style="aspect-ratio:2/3; display:flex; align-items:center; justify-content:center; font-size:3rem; background:var(--color-surface);">🎬</div>
              )}
              <div class="poster-overlay-guard"></div>

              <!-- Bloque de estrellas y valoración -->
              <div class="card-rating-block">
                <a href={`${baseUrl}?movie=${movie.id}`} class="star-rating-container has-average-rating is-interactive" style="display:flex; text-decoration:none;" title="Valorar en Videoclub Digital" aria-label="Valorar en Videoclub Digital">
                  <svg class="star-icon" data-rating-level="1" style={isSuspenso || avgStars > 0 ? "opacity: 1;" : "opacity: 0;"}>
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip1}% 0 0);`}></use>
                  </svg>
                  <svg class="star-icon" data-rating-level="2" style={!isSuspenso && avgStars > 1 ? "opacity: 1;" : "opacity: 0;"}>
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip2}% 0 0);`}></use>
                  </svg>
                  <svg class="star-icon" data-rating-level="3" style={!isSuspenso && avgStars > 2 ? "opacity: 1;" : "opacity: 0;"}>
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip3}% 0 0);`}></use>
                  </svg>
                </a>


                
                <!-- Botón CTA para abrir modal interactivo en SPA -->
                <a href={`${baseUrl}?movie=${movie.id}`} class="card-action-btn" title="Añadir a mi lista en el videoclub" aria-label="Añadir a mi lista en el videoclub">
                  <svg class="icon-watchlist"><use href={`${baseUrl}sprite.svg#icon-bookmark-plus`}></use></svg>
                </a>
              </div>
            </div>

            <!-- Resumen: Título, Estudios y Año -->
            <div class="movie-info movie-summary">
              <div class="title-director-block">
                <h1 data-template="title" class={`movie-main-title ${titleLengthClass}`}>{movie.title}</h1>
              </div>


              <div class="movie-meta">
                {studios.length > 0 && (
                  <div class="card-icons-line">
                    {studios.map(code => {
                      const conf = STUDIO_DATA[code];
                      if (!conf) return null;
                      return (
                        <span class={`platform-icon ${conf.class}`} title={conf.title}>
                          <svg width={conf.w || 24} height={conf.h || 24} fill="currentColor" viewBox="0 0 24 24">
                            <use href={`${baseUrl}sprite.svg#${conf.id}`}></use>
                          </svg>
                        </span>
                      );
                    })}
                  </div>
                )}
                <div class="modal-horizontal-divider"></div>
                <div class="year-country-line">
                  <div class="year-flag-group">
                    {movie.year && (
                      <span data-template="year">
                        <a href={`${baseUrl}?year=${movie.year}`} class="year-link">{movie.year}</a>
                        {formatYear(movie.year, movie.year_end, isSeries, '', movie.type).substring(String(movie.year).length)}
                      </span>
                    )}
                    {countryCode && (
                      <span class="country-info" data-template="country-container" style="display:flex;">
                        <span class="country-flag-icon" title={countryName}>
                          <svg width="28" height="28"><use href={`${baseUrl}flags.svg#flag-${countryCode.toLowerCase()}`}></use></svg>
                        </span>
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- COLUMNA DERECHA EN DESKTOP / ABAJO EN MÓVIL (FRONTCARD) -->
          <div class="flip-card-back">
            
            <!-- Duración, Episodios y Links Externos -->
            <div class="back-meta-header">
              <div class="episode-duration-group">
                {episodesText && <span data-template="episodes">{episodesText}</span>}
                {durationText && <span data-template="duration">{durationText}</span>}
                {movie.justwatch && (
                  <a target="_blank" rel="noopener noreferrer" class="rating-line" href={movie.justwatch} title="Ver en JustWatch" data-template="justwatch-link">
                    <svg class="rating-icon" fill="#9A1485"><use href={`${baseUrl}sprite.svg#icon-justwatch`}></use></svg>
                  </a>
                )}
                {movie.wikipedia && (
                  <a target="_blank" rel="noopener noreferrer" class="rating-line" href={movie.wikipedia} title="Ver en Wikipedia" data-template="wikipedia-link">
                    <svg class="rating-icon" fill="#B3404A"><use href={`${baseUrl}sprite.svg#icon-wikipedia`}></use></svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Sección Puntuaciones: FilmAffinity e IMDb con barras -->
            <div class="ratings-container">
              {movie.fa_rating && (
                <div class="rating-line">
                  <a target="_blank" rel="noopener noreferrer" class="rating-left" href={movie.fa_id || '#'} data-template="fa-link">
                    <svg class="rating-icon"><use href={`${baseUrl}sprite.svg#icon-filmaffinity`}></use></svg>
                    <span data-template="fa-rating">{movie.fa_rating.toFixed(1)}</span>
                  </a>
                  <span class="rating-votes-count">{formattedFaVotes}</span>
                  <div class="rating-bar-container" style="display:block;" data-votes={formattedFaVotes}>
                    <div class="rating-bar" style={`width: ${faBarWidth}%;`}></div>
                  </div>
                </div>
              )}

              {movie.imdb_rating && (
                <div class="rating-line">
                  <a target="_blank" rel="noopener noreferrer" class="rating-left" href={movie.imdb_id || '#'} data-template="imdb-link">
                    <svg class="rating-icon" fill="#F5C618"><use href={`${baseUrl}sprite.svg#icon-imdb`}></use></svg>
                    <span data-template="imdb-rating">{movie.imdb_rating.toFixed(1)}</span>
                  </a>
                  <span class="rating-votes-count">{formattedImdbVotes}</span>
                  <div class="rating-bar-container" style="display:block;" data-votes={formattedImdbVotes}>
                    <div class="rating-bar" style={`width: ${imdbBarWidth}%;`}></div>
                  </div>
                </div>
              )}
            </div>

            <!-- Título Original tras las Puntuaciones -->
            <div class="back-original-title-wrapper">
              <span data-template="original-title" class={origTitleLengthClass}>{displayOriginalTitle}</span>
            </div>

            <!-- Director tras el Título Original -->
            {directors.length > 0 && (
              <div class="front-director-info" data-template="director">
                {directors.map((name, i) => (
                  <><a href={`${baseUrl}director/${toSlug(name)}/`}>{preserveHyphenatedWords(name)}</a>{i < directors.length - 1 ? ', ' : ''}</>
                ))}
              </div>
            )}

            <!-- Géneros y Reparto Principal -->
            <div class="details-list">
              {genres.length > 0 && (
                <div class="detail-item" data-template="genre-container">
                  <span class="detail-label">
                    <svg class="detail-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href={`${baseUrl}sprite.svg#icon-clapperboard`}></use></svg>
                  </span>
                  <strong class="detail-label-title">Género.</strong>
                  <span class="detail-data" data-template="genre">
                    {genres.map((name, i) => {
                      const slug = genreToSlug(name);
                      return (
                        <>{slug ? (
                          <a href={`${baseUrl}${slug}/`}>{preserveHyphenatedWords(name)}</a>
                        ) : (
                          <span>{preserveHyphenatedWords(name)}</span>
                        )}{i < genres.length - 1 ? ', ' : ''}</>
                      );
                    })}
                  </span>
                </div>
              )}
              {actors.length > 0 && (
                <div class="detail-item" data-template="actors-container">
                  <span class="detail-label">
                    <svg class="detail-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href={`${baseUrl}sprite.svg#icon-cast`}></use></svg>
                  </span>
                  <strong class="detail-label-title">Reparto.</strong>
                  <span class="detail-data" data-template="actors">
                    {actors.map((name, i) => (
                      <><a href={`${baseUrl}actor/${toSlug(name)}/`}>{preserveHyphenatedWords(name)}</a>{i < actors.length - 1 ? ', ' : ''}</>
                    ))}
                  </span>
                </div>
              )}
            </div>

            <!-- Sinopsis -->
            {movie.synopsis && (
              <div class="scrollable-content">
                <div class="plot-summary-final" title="Sinopsis">
                  <span class="detail-label">
                    <svg class="detail-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href={`${baseUrl}sprite.svg#icon-synopsis`}></use></svg>
                  </span>
                  <strong class="detail-label-title">Sinopsis.</strong>
                  <span data-template="synopsis">{preserveHyphenatedWords(movie.synopsis)}</span>
                </div>
              </div>
            )}







          </div>

        </div>
      </article>

    </div>
  </div>
</body>
</html>

