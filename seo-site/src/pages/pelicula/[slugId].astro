---
import { fetchAllMovies } from '../../lib/fetchAllMovies';
import { getPosterUrl, parseList } from '../../lib/format';
import type { MovieRow } from '../../lib/types';

export async function getStaticPaths() {
  const movies = await fetchAllMovies();
  return movies.map((movie) => ({
    params: { slugId: movie.slug },
    props: { movie },
  }));
}

interface Props { movie: MovieRow }
const { movie } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posterUrl = getPosterUrl(movie);
const genres = parseList(movie.genres_list);
const directors = parseList(movie.directors_list);
const actors = parseList(movie.actors_list);
const studios = parseList(movie.studios_list);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isSeries = Boolean(movie.type && String(movie.type).toLowerCase().startsWith('s'));

const pageTitle = `${movie.title}${movie.year ? ` (${movie.year})` : ''} — Videoclub Digital`;
const description = movie.synopsis
  ? movie.synopsis.slice(0, 155) + (movie.synopsis.length > 155 ? '…' : '')
  : `Ficha de ${movie.title} en Videoclub Digital.`;

// Constantes de estudio
const STUDIO_DATA: Record<string, { id: string; class: string; title: string; w: number; h: number }> = {
  N: { id: 'icon-netflix', class: 'netflix-icon', title: 'Netflix', w: 20, h: 20 },
  D: { id: 'icon-disney', class: 'disney-icon', title: 'Disney', w: 20, h: 20 },
  W: { id: 'icon-wb', class: 'wb-icon', title: 'Warner Bros.', w: 20, h: 20 },
  U: { id: 'icon-universal', class: 'universal-icon', title: 'Universal', w: 20, h: 20 },
  S: { id: 'icon-sony', class: 'sony-icon', title: 'Sony-Columbia', w: 20, h: 20 },
  P: { id: 'icon-paramount', class: 'paramount-icon', title: 'Paramount', w: 20, h: 20 },
  L: { id: 'icon-lionsgate', class: 'lionsgate-icon', title: 'Lionsgate', w: 20, h: 20 },
  Z: { id: 'icon-amazon', class: 'amazon-icon', title: 'Amazon MGM', w: 20, h: 20 },
  F: { id: 'icon-twenty', class: 'twenty-icon', title: '20th Century Fox', w: 20, h: 20 },
  T: { id: 'icon-a24', class: 'a24-icon', title: 'A24', w: 20, h: 20 },
  O: { id: 'icon-movistar', class: 'movistar-icon', title: 'Movistar', w: 20, h: 20 },
  X: { id: 'icon-miramax', class: 'miramax-icon', title: 'Miramax', w: 20, h: 20 },
  A: { id: 'icon-apple', class: 'apple-icon', title: 'Apple TV', w: 20, h: 20 },
  C: { id: 'icon-canalplus', class: 'canalplus-icon', title: 'StudioCanal', w: 20, h: 20 },
  B: { id: 'icon-bbc', class: 'bbc-icon', title: 'BBC', w: 20, h: 20 }
};

// Formatos de visualización
const countryCode = movie.countries?.code || null;
const countryName = movie.countries?.name || '';

function formatRuntime(minutes: number | null | undefined, isSeries: boolean): string {
  if (!minutes) return isSeries ? 'Serie TV' : 'Película';
  const hrs = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (isSeries) return `${minutes} min/ep`;
  if (hrs === 0) return `${mins} m`;
  if (mins === 0) return `${hrs} h`;
  return `${hrs} h ${mins} m`;
}

const durationText = formatRuntime(movie.minutes, isSeries);
const episodesText = movie.episodes ? `${movie.episodes} ep` : null;

// Clases de tamaño de título
const tLen = movie.title.length;
let titleLengthClass = '';
if (tLen > 70) titleLengthClass = 'title-xxxl-long';
else if (tLen > 50) titleLengthClass = 'title-xxl-long';
else if (tLen > 35) titleLengthClass = 'title-xl-long';
else if (tLen > 25) titleLengthClass = 'title-long';
else if (tLen > 15) titleLengthClass = 'title-medium';

const displayOriginalTitle = movie.original_title?.trim() || movie.title;
const oLen = displayOriginalTitle.length;
let origTitleLengthClass = '';
if (oLen > 40) origTitleLengthClass = 'title-xl-long';
else if (oLen > 30) origTitleLengthClass = 'title-long';
else if (oLen > 20) origTitleLengthClass = 'title-medium';

// Estrellas continuas (0-3)
function calculateAverageStars(avg: number | null | undefined): number {
  if (!avg || avg <= 5.5) return 0;
  if (avg >= 9.0) return 3;
  return ((avg - 5.5) / 3.5) * 3;
}
const avgStars = calculateAverageStars(movie.avg_rating);
const clip1 = (1 - Math.max(0, Math.min(1, avgStars - 0))) * 100;
const clip2 = (1 - Math.max(0, Math.min(1, avgStars - 1))) * 100;
const clip3 = (1 - Math.max(0, Math.min(1, avgStars - 2))) * 100;

// Cálculo de barras de votos y votos unificados
const SQRT_MAX_VOTES = { FA: Math.sqrt(220000), IMDB: Math.sqrt(3200000) };
function formatVotesUnified(votes: number | null | undefined, key: 'fa' | 'imdb'): string {
  if (!votes) return '';
  if (key === 'fa') {
    return votes >= 1000 ? `${Math.round(votes / 1000)}k` : String(votes);
  }
  if (votes >= 1000000) return `${(votes / 1000000).toFixed(1)}M`;
  if (votes >= 1000) return `${Math.round(votes / 1000)}k`;
  return String(votes);
}

const faBarWidth = movie.fa_votes ? Math.min(100, (Math.sqrt(movie.fa_votes) / SQRT_MAX_VOTES.FA) * 100) : 0;
const imdbBarWidth = movie.imdb_votes ? Math.min(100, (Math.sqrt(movie.imdb_votes) / SQRT_MAX_VOTES.IMDB) * 100) : 0;
const formattedFaVotes = formatVotesUnified(movie.fa_votes, 'fa');
const formattedImdbVotes = formatVotesUnified(movie.imdb_votes, 'imdb');

const sameAs = [movie.imdb_id, movie.fa_id, movie.wikipedia, movie.justwatch].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isSeries ? 'TVSeries' : 'Movie',
  name: movie.title,
  ...(sameAs.length ? { sameAs } : {}),
  ...(movie.original_title ? { alternateName: movie.original_title } : {}),
  ...(movie.year ? { datePublished: String(movie.year) } : {}),
  ...(movie.synopsis ? { description: movie.synopsis } : {}),
  ...(posterUrl ? { image: posterUrl } : {}),
  ...(directors.length ? { director: directors.map((name) => ({ '@type': 'Person', name })) } : {}),
  ...(actors.length ? { actor: actors.map((name) => ({ '@type': 'Person', name })) } : {}),
  ...(movie.avg_rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: movie.avg_rating.toFixed(1),
          bestRating: '10',
          ratingCount: (movie.fa_votes || 0) + (movie.imdb_votes || 0),
        },
      }
    : {}),
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OpenGraph / Facebook / WhatsApp -->
  <meta property="og:type" content="video.movie" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {posterUrl && <meta property="og:image" content={posterUrl} />}
  <meta property="og:url" content={canonicalUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {posterUrl && <meta name="twitter:image" content={posterUrl} />}

  <!-- Tipografía Inter Variable Autoalojada (Misma que la SPA) -->
  <link rel="preconnect" href="https://wibygecgfczcvaqewleq.supabase.co" crossorigin />
  <link rel="preload" href="https://wibygecgfczcvaqewleq.supabase.co/storage/v1/object/public/assets/Inter-Variable-v41.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <!-- Estilos visuales identicos al Modal de la SPA -->
  <style is:global>
    /* Inter Variable: Un solo archivo para todos los pesos */
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("https://wibygecgfczcvaqewleq.supabase.co/storage/v1/object/public/assets/Inter-Variable-v41.woff2") format("woff2");
    }

    /* Fallback métricamente ajustado para reducir CLS */
    @font-face {
      font-family: "Inter Fallback";
      src: local("Arial");
      ascent-override: 92.77%;
      descent-override: 24.41%;
      line-gap-override: 0%;
      size-adjust: 107.8%;
    }

    /* RESET & DESIGN TOKENS (dark-mode por defecto) */
    :root, html.dark-mode {
      --font-body: "Inter", "Inter Fallback", system-ui, -apple-system, sans-serif;
      --font-title: var(--font-body);

      --font-size-xs: 0.75rem;
      --font-size-sm: 0.875rem;
      --font-size-base: 1rem;
      --font-size-md: 1.125rem;
      --font-size-lg: 1.25rem;
      --font-size-xl: 1.5rem;
      --font-size-xxl: 2rem;

      --line-height-tight: 1.1;
      --line-height-normal: 1.5;

      --font-weight-light: 300;
      --font-weight-normal: 400;
      --font-weight-medium: 500;
      --font-weight-semibold: 600;
      --font-weight-bold: 700;
      --font-weight-extrabold: 800;

      --color-header-bg: rgba(13, 13, 13, 0.85);
      --color-overlay-bg: rgba(0, 0, 0, 0.65);
      --modal-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08);
      --color-bg: #0d0d0d;
      --color-surface: #1a1a1a;
      --color-surface-1: #242424;
      --color-surface-2: #2e2e2e;

      --color-text-primary: #e0e0e0;
      --color-text-secondary: #b8b8b8;
      --color-text-tertiary: #a0a0a0;

      --color-border: #3a3a3a;
      --color-border-soft: rgba(255, 255, 255, 0.12);

      --color-accent: #b0bec5;
      --color-accent-darker: #b0bec5;
      --color-accent-lighter: #ffffff;
      --color-focus: rgba(176, 190, 197, 0.4);

      --space-xxs: 0.25rem;
      --space-xs: 0.5rem;
      --space-sm: 0.75rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2rem;

      --radius-sm: 4px;
      --radius-md: 6px;
      --radius-lg: 8px;
      --radius-xl: 12px;
      --radius-xxl: 16px;

      --shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);

      --duration-fast: 300ms;
      --duration-normal: 400ms;
      --ease-smooth-out: cubic-bezier(0.22, 0.61, 0.36, 1);

      --z-index-overlay: 1999;
    }

    @media (prefers-color-scheme: light) {
      :root:not(.dark-mode) {
        --color-header-bg: rgba(255, 255, 255, 0.85);
        --color-overlay-bg: rgba(0, 0, 0, 0.18);
        --modal-shadow: 0 12px 40px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.08);
        --color-bg: #f5f5f5;
        --color-surface: #ffffff;
        --color-surface-1: #ffffff;
        --color-surface-2: #ffffff;

        --color-text-primary: #1a1a1a;
        --color-text-secondary: #4a4a4a;
        --color-text-tertiary: #666666;

        --color-border: #e0e0e0;
        --color-border-soft: rgba(0, 0, 0, 0.07);

        --color-accent: #37474f;
        --color-accent-darker: #263238;
        --color-accent-lighter: #546e7a;
        --color-focus: rgba(55, 71, 79, 0.4);

        --shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background-color: var(--color-bg) !important;
      color: var(--color-text-primary) !important;
      font-family: var(--font-body);
      min-height: 100vh;
      width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    /* HEADER DE MARCA SUPERIOR */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      z-index: 2000;
      background: var(--color-header-bg);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
      padding: 0 20px;
      display: flex;
      align-items: center;
    }

    .header-content {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--color-text-primary);
      letter-spacing: -0.02em;
    }

    .logo-accent {
      color: #f59e0b;
    }

    .btn-header-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.35);
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-header-cta:hover {
      background: #f59e0b;
      color: #0d0d0d;
    }

    /* CORTINA OSCURA Y VENTANA MODAL (SPA QUICK VIEW) */
    .quick-view-overlay {
      position: fixed;
      inset: 0;
      z-index: var(--z-index-overlay);
      background-color: var(--color-overlay-bg);
      backdrop-filter: blur(6px) saturate(85%);
      -webkit-backdrop-filter: blur(6px) saturate(85%);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .quick-view-modal {
      position: fixed;
      z-index: calc(var(--z-index-overlay) + 1);
      display: flex;
      background-color: var(--color-surface-2);
      box-shadow: var(--modal-shadow);
      overflow: hidden;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .quick-view-content {
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: var(--color-border) var(--color-bg);
    }

    .quick-view-content::-webkit-scrollbar,
    .flip-card-back::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .quick-view-content::-webkit-scrollbar-track,
    .flip-card-back::-webkit-scrollbar-track {
      background: var(--color-bg);
    }
    .quick-view-content::-webkit-scrollbar-thumb,
    .flip-card-back::-webkit-scrollbar-thumb {
      background-color: var(--color-border);
      border-radius: 9999px;
      border: 2px solid var(--color-bg);
    }
    .quick-view-content::-webkit-scrollbar-thumb:hover,
    .flip-card-back::-webkit-scrollbar-thumb:hover {
      background-color: var(--color-text-secondary);
    }

    .is-quick-view.movie-card {
      aspect-ratio: auto;
      perspective: none;
      animation: none;
      width: 100%;
      height: 100%;
    }

    .is-quick-view .flip-card-inner {
      transform-style: flat;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      height: 100%;
      background-color: var(--color-surface-2);
      border: none;
    }

    .is-quick-view :is(.flip-card-front, .flip-card-back) {
      position: relative;
      inset: auto;
      transform: none;
      backface-visibility: visible;
      height: auto;
      overflow: visible;
      background-color: var(--color-surface-2);
      color: var(--color-text-primary);
    }

    .is-quick-view .flip-card-front {
      padding: var(--space-lg);
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
    }

    .is-quick-view .flip-card-back {
      padding: var(--space-lg);
      flex-grow: 1;
      min-width: 0;
      pointer-events: auto;
    }

    .is-quick-view .poster-container {
      height: auto;
      width: 100%;
      border: none;
      position: relative;
    }

    .is-quick-view .poster-container img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-xxl);
      box-shadow: var(--shadow);
      border: none;
      display: block;
      object-fit: cover;
    }

    .is-quick-view .movie-summary {
      padding-inline: 0;
      padding-top: 0;
      display: flex;
      flex-direction: column;
    }

    .is-quick-view .title-director-block {
      min-height: 82px;
      justify-content: center;
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
    }

    .is-quick-view .movie-summary h3[data-template="title"] {
      font-size: 2rem;
      font-weight: var(--font-weight-extrabold);
      color: var(--color-text-primary);
      line-height: 1.1;
      margin-bottom: 4px;
      letter-spacing: -0.03em;

      &.title-medium { font-size: 1.7rem; }
      &.title-long { font-size: 1.4rem; }
      &.title-xl-long { font-size: 1.15rem; }
      &.title-xxl-long { font-size: 1rem; }
      &.title-xxxl-long { font-size: 0.85rem; }
    }

    .is-quick-view .front-director-info {
      font-size: calc(var(--font-size-xs) * 1.5);
      color: var(--color-text-secondary);
      margin-top: 4px;
      margin-bottom: var(--space-md);
      line-height: 1.4;
      white-space: normal;
      display: block;
      width: 100%;

      & a {
        color: inherit;
        text-decoration: none;

        &:hover {
          color: var(--color-text-primary);
          text-decoration: underline;
        }
      }
    }

    .is-quick-view .card-rating-block {
      position: relative;
      z-index: 10;
      transform: none;
      padding: 0 0 2px;
      margin: -8px 0 0;
      pointer-events: auto;
      justify-content: center;
      align-items: center;
      gap: var(--space-lg);
      display: flex;
    }

    .is-quick-view .card-rating-block * {
      pointer-events: auto;
    }

    .is-quick-view .star-rating-container {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      cursor: pointer;
    }

    .star-rating-container.is-interactive .star-icon:hover {
      transform: scale(1.35);
      z-index: 20;
      filter: drop-shadow(0 0 4px rgba(255, 189, 7, 0.6));
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .star-rating-container.is-interactive .star-icon:active {
      transform: scale(0.92);
      filter: brightness(0.95);
    }

    .is-quick-view .star-icon {
      width: 42px;
      height: 42px;
      position: relative;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .star-icon-path {
      stroke: var(--color-accent);
      stroke-width: 2;
      stroke-linejoin: round;
      stroke-linecap: round;
    }

    .star-icon-path--empty { fill: transparent; }
    .star-icon-path--filled {
      fill: var(--color-accent);
      clip-path: inset(0 100% 0 0);
    }

    .is-quick-view .card-action-btn {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-primary);
      text-decoration: none;
      transition: background-color 0.2s ease, transform 0.2s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: scale(1.05);
      }

      &.is-active {
        background: rgba(229, 9, 20, 0.2);
        border-color: #e50914;

        & svg {
          color: #e50914 !important;
          fill: #e50914 !important;
          stroke: #e50914 !important;
        }
      }

      & svg {
        width: 38px;
        height: 38px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5px;
      }
    }

    .is-quick-view .movie-meta {
      display: flex;
      align-items: center;
      margin-top: auto;
      padding-top: var(--space-xs);
    }

    .is-quick-view .modal-horizontal-divider {
      flex-grow: 1;
      height: 1px;
      background-color: var(--color-border);
      align-self: center;
      margin-inline: var(--space-md);
      opacity: 0.8;
    }

    .is-quick-view .card-icons-line {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }

    .is-quick-view .platform-icon svg {
      width: 33px;
      height: 33px;
    }

    /* COLORES ESTUDIOS */
    .netflix-icon { color: #e50914; }
    .disney-icon { color: #D9534F; }
    .wb-icon { color: #4da4f2; }
    .universal-icon { color: #BBBBBB; }
    .sony-icon { color: #3182ce; }
    .paramount-icon { color: #E0E0E0; }
    .lionsgate-icon { color: #f9d7b5; }
    .amazon-icon { color: #f6a61f; }
    .twenty-icon { color: #E0E0E0; }
    .a24-icon { color: #fff; }
    .movistar-icon { color: #00a9e0; }
    .miramax-icon { color: #4da4f2; }
    .apple-icon { color: #fff; }
    .canalplus-icon { color: #fff; }
    .bbc-icon { color: #fff; }

    .is-quick-view .year-flag-group {
      display: flex;
      align-items: center;
      font-size: 2rem;
      line-height: 1;
      gap: var(--space-sm);
    }

    .is-quick-view .year-link {
      color: inherit;
      text-decoration: none;
      font-weight: var(--font-weight-bold);
    }

    .country-info { display: flex; align-items: center; gap: var(--space-xxs); }
    .is-quick-view .country-flag-icon svg {
      width: 28px;
      height: 28px;
      box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
    }

    /* COSTADO TRASERO (DERECHO EN DESKTOP) */
    .is-quick-view .back-meta-header {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      width: 100%;
      margin-bottom: var(--space-lg);
    }

    .is-quick-view .episode-duration-group {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: calc(var(--font-size-sm) * 1.5);
      letter-spacing: 1px;
      color: var(--color-text-secondary);
    }

    [data-template="wikipedia-link"],
    [data-template="justwatch-link"] {
      display: flex;
      align-items: center;
      text-decoration: none;
      margin-left: var(--space-xs);

      & svg {
        width: 1.5em;
        height: 1.5em;
      }
    }

    .is-quick-view .ratings-container {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .is-quick-view .rating-line {
      display: flex;
      align-items: center;
      gap: 12px;
      font-variant-numeric: tabular-nums;
    }

    .is-quick-view .rating-left {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--color-text-primary);
      font-size: calc(var(--font-size-base) * 1.5);
      font-weight: var(--font-weight-bold);
      text-decoration: none;
      flex-shrink: 0;

      &:hover { opacity: 0.85; }
    }

    .is-quick-view .rating-icon {
      width: 1.6em;
      height: 1.6em;
      border-radius: var(--radius-sm);
    }

    .is-quick-view .rating-votes-count {
      display: flex !important;
      flex-direction: column;
      justify-content: center;
      min-width: 5ch;
      text-align: right;
      font-size: var(--font-size-base);
      font-weight: bold;
      line-height: 1;

      &::after {
        content: "votos";
        font-size: 0.6em;
        font-weight: normal;
        color: var(--color-text-secondary);
        text-align: right;
        width: 100%;
        margin-top: 2px;
      }
    }

    .is-quick-view .rating-bar-container {
      flex-grow: 1;
      width: 100%;
      height: var(--space-sm);
      border-radius: var(--space-xxs);
      background-color: var(--color-bg);
      overflow: hidden;
      position: relative;
    }

    .is-quick-view .rating-bar {
      height: 100%;
      border-radius: var(--space-xxs);
      background-color: var(--color-accent);
    }

    .is-quick-view .back-original-title-wrapper {
      margin-top: var(--space-lg);
      margin-bottom: 0;
      padding: 0;

      & span {
        font-size: 1.6rem;
        font-weight: bold;
        line-height: 1.1;
        color: var(--color-text-primary);

        &.title-medium { font-size: 1.45rem; }
        &.title-long { font-size: 1.3rem; }
        &.title-xl-long { font-size: 1.05rem; }
      }
    }

    .is-quick-view .front-director-info {
      font-size: calc(var(--font-size-xs) * 1.5);
      font-weight: var(--font-weight-normal);
      color: var(--color-text-secondary);
      margin-top: 4px;
      margin-bottom: var(--space-xs);
      line-height: 1.4;

      & a {
        color: inherit;
        text-decoration: none;
        transition: color var(--duration-fast);

        &:hover {
          color: var(--color-text-primary);
          text-decoration: underline;
        }
      }
    }

    .is-quick-view .details-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      margin-bottom: 0;
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
      font-size: calc(var(--font-size-xs) * 1.5);
      line-height: 1.5;
      color: var(--color-text-secondary);
    }

    .is-quick-view .detail-item[data-template="actors-container"],
    .is-quick-view .detail-item[data-template="genre-container"] {
      display: block;
      white-space: normal;
    }

    .is-quick-view [data-template="actors"] a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--color-text-primary);
        text-decoration: underline;
      }
    }

    .is-quick-view .detail-label {
      font-size: 1.5em;
      line-height: 1;
      vertical-align: -0.15em;
      margin-right: var(--space-xs);
    }

    .is-quick-view .scrollable-content {
      overflow: visible;
      height: auto;

      &::after { display: none; }
    }

    .is-quick-view .plot-summary-final {
      margin-top: var(--space-lg);
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
      font-size: calc(var(--font-size-xs) * 1.5);
      line-height: 1.5;
      color: var(--color-text-secondary);
    }

    /* ADAPTACIÓN ESCRITORIO (min-width: 701px) - Ventana Flotante Clásica 2 Columnas */
    @media (min-width: 701px) {
      .quick-view-modal {
        top: 50%;
        left: 50%;
        width: 90%;
        max-width: 720px;
        max-height: 92vh;
        height: auto;
        border-radius: var(--radius-xl);
        transform: translate(-50%, -50%);
      }

      .is-quick-view .flip-card-inner {
        display: block;
        position: relative;
        overflow: visible;
      }

      .is-quick-view .flip-card-front {
        width: 50%;
        height: auto;
        border-right: 1px solid var(--color-border);
        border-bottom: none;
        overflow-y: hidden;
      }

      .is-quick-view .flip-card-back {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: auto;
        width: 50%;
        overflow-y: auto;
        scrollbar-width: thin;
      }
    }

    /* ADAPTACIÓN MÓVIL (max-width: 700px) - Bottom Sheet desde abajo */
    @media (max-width: 700px) {
      .site-header {
        padding: 0 12px;
      }

      .quick-view-modal {
        top: auto;
        bottom: 0;
        left: 50%;
        width: 96%;
        height: 92dvh;
        max-height: 92dvh;
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        transform: translate(-50%, 0);
      }

      /* Barrita superior de arrastre */
      .quick-view-modal::before {
        content: "";
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 5px;
        background-color: var(--color-border);
        border-radius: 10px;
        z-index: 10;
        pointer-events: none;
      }

      .is-quick-view .flip-card-inner {
        flex-direction: column;
      }

      .is-quick-view .flip-card-front {
        padding-top: 30px;
        padding-bottom: var(--space-xs);
        border-bottom: none;
        width: 100%;
      }

      .is-quick-view .poster-container {
        width: 70%;
        margin-inline: auto;
      }

      .is-quick-view .flip-card-back {
        padding-top: 0;
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- Header Superior de Marca -->
  <header class="site-header">
    <div class="header-content">
      <a href={baseUrl} class="brand-logo">
        <span class="logo-icon">🎬</span>
        <span class="logo-text">videoclub<span class="logo-accent">.digital</span></span>
      </a>
      <a href={`${baseUrl}?movie=${movie.id}`} class="btn-header-cta">
        <span class="btn-icon">⚡</span> Abrir en la App
      </a>
    </div>
  </header>

  <!-- Cortina Oscura (Overlay) -->
  <div class="quick-view-overlay is-visible"></div>

  <!-- Contenedor Ventana Modal (Quick View) -->
  <div id="quick-view-modal" class="quick-view-modal is-visible" role="dialog" aria-modal="true">
    <div id="quick-view-content" class="quick-view-content">
      
      <!-- Ficha de Película con contrato de clases de la SPA -->
      <article class="movie-card is-quick-view" data-movie-id={movie.id}>
        <div class="flip-card-inner">

          <!-- COLUMNA IZQUIERDA EN DESKTOP / ARRIBA EN MÓVIL (FRONTCARD) -->
          <div class="flip-card-front">
            
            <!-- Contenedor del Póster -->
            <div class="poster-container">
              {posterUrl ? (
                <img 
                  src={posterUrl} 
                  alt={`Póster de ${movie.title}`} 
                  width="400" 
                  height="496" 
                  loading="eager" 
                  fetchpriority="high"
                  class="loaded"
                />
              ) : (
                <div class="poster-fallback" style="aspect-ratio:2/3; display:flex; align-items:center; justify-content:center; font-size:3rem; background:var(--color-surface);">🎬</div>
              )}
              <div class="poster-overlay-guard"></div>

              <!-- Bloque de estrellas y valoración -->
              <div class="card-rating-block">
                <div class="star-rating-container has-user-rating" style="display:flex;">
                  <svg class="star-icon" data-rating-level="1">
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip1}% 0 0);`}></use>
                  </svg>
                  <svg class="star-icon" data-rating-level="2">
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip2}% 0 0);`}></use>
                  </svg>
                  <svg class="star-icon" data-rating-level="3">
                    <use class="star-icon-path star-icon-path--empty" href={`${baseUrl}sprite.svg#icon-star`}></use>
                    <use class="star-icon-path star-icon-path--filled" href={`${baseUrl}sprite.svg#icon-star`} style={`clip-path: inset(0 ${clip3}% 0 0);`}></use>
                  </svg>
                </div>
                
                <!-- Botón CTA para abrir modal interactivo en SPA -->
                <a href={`${baseUrl}?movie=${movie.id}`} class="card-action-btn" title="Abrir en Videoclub Digital" aria-label="Abrir en la App">
                  <svg class="icon-watchlist"><use href={`${baseUrl}sprite.svg#icon-bookmark-plus`}></use></svg>
                </a>
              </div>
            </div>

            <!-- Resumen: Título, Estudios y Año -->
            <div class="movie-info movie-summary">
              <div class="title-director-block">
                <h3 data-template="title" class={titleLengthClass}>{movie.title}</h3>
              </div>

              <div class="movie-meta">
                {studios.length > 0 && (
                  <div class="card-icons-line">
                    {studios.map(code => {
                      const conf = STUDIO_DATA[code];
                      if (!conf) return null;
                      return (
                        <span class={`platform-icon ${conf.class}`} title={conf.title}>
                          <svg width={conf.w || 24} height={conf.h || 24} fill="currentColor" viewBox="0 0 24 24">
                            <use href={`${baseUrl}sprite.svg#${conf.id}`}></use>
                          </svg>
                        </span>
                      );
                    })}
                  </div>
                )}
                <div class="modal-horizontal-divider"></div>
                <div class="year-country-line">
                  <div class="year-flag-group">
                    {movie.year && (
                      <span data-template="year">
                        <a href={`${baseUrl}?year=${movie.year}`} class="year-link">{movie.year}</a>
                        {movie.year_end ? `–${movie.year_end}` : ''}
                      </span>
                    )}
                    {countryCode && (
                      <span class="country-info" data-template="country-container" style="display:flex;">
                        <span class="country-flag-icon" title={countryName}>
                          <svg width="28" height="28"><use href={`${baseUrl}flags.svg#flag-${countryCode.toLowerCase()}`}></use></svg>
                        </span>
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- COLUMNA DERECHA EN DESKTOP / ABAJO EN MÓVIL (FRONTCARD) -->
          <div class="flip-card-back">
            
            <!-- Duración, Episodios y Links Externos -->
            <div class="back-meta-header">
              <div class="episode-duration-group">
                {episodesText && <span data-template="episodes">{episodesText}</span>}
                {durationText && <span data-template="duration">{durationText}</span>}
                {movie.justwatch && (
                  <a target="_blank" rel="noopener noreferrer" class="rating-line" href={movie.justwatch} title="Ver en JustWatch" data-template="justwatch-link">
                    <svg class="rating-icon" fill="#9A1485"><use href={`${baseUrl}sprite.svg#icon-justwatch`}></use></svg>
                  </a>
                )}
                {movie.wikipedia && (
                  <a target="_blank" rel="noopener noreferrer" class="rating-line" href={movie.wikipedia} title="Ver en Wikipedia" data-template="wikipedia-link">
                    <svg class="rating-icon" fill="#B3404A"><use href={`${baseUrl}sprite.svg#icon-wikipedia`}></use></svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Sección Puntuaciones: FilmAffinity e IMDb con barras -->
            <div class="ratings-container">
              {movie.fa_rating && (
                <div class="rating-line">
                  <a target="_blank" rel="noopener noreferrer" class="rating-left" href={movie.fa_id || '#'} data-template="fa-link">
                    <svg class="rating-icon"><use href={`${baseUrl}sprite.svg#icon-filmaffinity`}></use></svg>
                    <span data-template="fa-rating">{movie.fa_rating.toFixed(1)}</span>
                  </a>
                  <span class="rating-votes-count">{formattedFaVotes}</span>
                  <div class="rating-bar-container" style="display:block;" data-votes={formattedFaVotes}>
                    <div class="rating-bar" style={`width: ${faBarWidth}%;`}></div>
                  </div>
                </div>
              )}

              {movie.imdb_rating && (
                <div class="rating-line">
                  <a target="_blank" rel="noopener noreferrer" class="rating-left" href={movie.imdb_id || '#'} data-template="imdb-link">
                    <svg class="rating-icon" fill="#F5C618"><use href={`${baseUrl}sprite.svg#icon-imdb`}></use></svg>
                    <span data-template="imdb-rating">{movie.imdb_rating.toFixed(1)}</span>
                  </a>
                  <span class="rating-votes-count">{formattedImdbVotes}</span>
                  <div class="rating-bar-container" style="display:block;" data-votes={formattedImdbVotes}>
                    <div class="rating-bar" style={`width: ${imdbBarWidth}%;`}></div>
                  </div>
                </div>
              )}
            </div>

            <!-- Título Original tras las Puntuaciones -->
            <div class="back-original-title-wrapper">
              <span data-template="original-title" class={origTitleLengthClass}>{displayOriginalTitle}</span>
            </div>

            <!-- Director tras el Título Original -->
            {directors.length > 0 && (
              <div class="front-director-info" data-template="director">
                {directors.map((name, i) => (
                  <>
                    <a href={`${baseUrl}?dir=${encodeURIComponent(name)}`}>{name}</a>
                    {i < directors.length - 1 ? ', ' : ''}
                  </>
                ))}
              </div>
            )}

            <!-- Géneros y Reparto Principal -->
            <div class="details-list">
              {genres.length > 0 && (
                <div class="detail-item" data-template="genre-container">
                  <span class="detail-label">🎬</span>
                  <span class="detail-data" data-template="genre">{genres.join(', ')}</span>
                </div>
              )}
              {actors.length > 0 && (
                <div class="detail-item" data-template="actors-container">
                  <span class="detail-label">✨</span>
                  <span class="detail-data" data-template="actors">
                    {actors.map((name, i) => (
                      <>
                        <a href={`${baseUrl}?actor=${encodeURIComponent(name)}`}>{name}</a>
                        {i < actors.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </span>
                </div>
              )}
            </div>

            <!-- Sinopsis -->
            {movie.synopsis && (
              <div class="scrollable-content">
                <div class="plot-summary-final" title="Sinopsis">
                  <span class="detail-label">🔹</span>
                  <span data-template="synopsis">{movie.synopsis}</span>
                </div>
              </div>
            )}

          </div>

        </div>
      </article>

    </div>
  </div>

  <script is:inline define:vars={{ baseUrl }}>
    document.addEventListener('DOMContentLoaded', () => {
      const starContainer = document.querySelector('.star-rating-container');
      if (starContainer) {
        starContainer.classList.add('is-interactive');
        const stars = starContainer.querySelectorAll('.star-icon');
        const filledPaths = Array.from(stars).map(s => s.querySelector('.star-icon-path--filled'));
        const initialClips = filledPaths.map(p => p ? p.style.clipPath : '');

        stars.forEach((star, index) => {
          star.addEventListener('mouseenter', () => {
            filledPaths.forEach((path, i) => {
              if (path) {
                path.style.clipPath = i <= index ? 'inset(0 0% 0 0)' : 'inset(0 100% 0 0)';
              }
            });
          });

          star.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const movieId = document.querySelector('.movie-card')?.getAttribute('data-movie-id');
            if (movieId) {
              window.location.href = `${baseUrl}?movie=${movieId}`;
            }
          });
        });

        starContainer.addEventListener('mouseleave', () => {
          filledPaths.forEach((path, i) => {
            if (path) {
              path.style.clipPath = initialClips[i] || '';
            }
          });
        });
      }

      const actionBtn = document.querySelector('.card-action-btn');
      if (actionBtn) {
        actionBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const movieId = document.querySelector('.movie-card')?.getAttribute('data-movie-id');
          if (movieId) {
            window.location.href = `${baseUrl}?movie=${movieId}`;
          }
        });
      }
    });
  </script>
</body>
</html>
